<Window x:Class="DynamicIsland.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DynamicIsland.UI"
        Title="Dynamic Island"
        Width="440" Height="210"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource IslandText}">
  <Window.Resources>
    <Style x:Key="Panel" TargetType="Grid">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontFamily" Value="{DynamicResource LabelFont}"/>
      <Setter Property="Foreground" Value="{DynamicResource FaintText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontFamily" Value="{DynamicResource LabelFont}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <SolidColorBrush x:Key="IslandText" Color="White"/>
    <SolidColorBrush x:Key="SubtleText" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="FaintText" Color="#73FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="ArtGlyphBrush" Color="#88FFFFFF"/>
    <SolidColorBrush x:Key="ArtPlaceholder" Color="#2C2C2E"/>

    <SolidColorBrush x:Key="PrimaryBg" Color="Transparent"/>
    <SolidColorBrush x:Key="PrimaryFg" Color="White"/>
    <SolidColorBrush x:Key="ControlBg" Color="Transparent"/>
    <SolidColorBrush x:Key="ControlRim" Color="Transparent"/>
    <Thickness x:Key="ControlRimWidth">0</Thickness>
    <FontFamily x:Key="LabelFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="CpTile" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource IslandText}"/>
      <Setter Property="Background" Value="{DynamicResource TrackBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="12"/>
              <Border x:Name="Bg" Background="Transparent" CornerRadius="12">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource IslandText}"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="100"/>
              <Border x:Name="Bg" Background="Transparent" CornerRadius="100">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource PressedBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Shape"
          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
          Width="120" Height="32" CornerRadius="16" UseLayoutRounding="False"
          Background="#FF000000" BorderBrush="#26FFFFFF" BorderThickness="1">
    <Border.LayoutTransform>
      <ScaleTransform x:Name="ShapeScale" ScaleX="1" ScaleY="1"/>
    </Border.LayoutTransform>
    <Border.RenderTransform>
      <TranslateTransform x:Name="ShapeDrop"/>
    </Border.RenderTransform>
    <Grid x:Name="ShapeContent">
      <Grid x:Name="IdlePanel" Style="{StaticResource Panel}" Height="30">
        <TextBlock x:Name="IdleClock" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"
                   FontWeight="SemiBold"/>
      </Grid>

      <Grid x:Name="CompactMediaPanel" Style="{StaticResource Panel}" Width="234" Height="30">
        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="10" Margin="6,0,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource ArtPlaceholder}">
          <TextBlock x:Name="CompactArtGlyph" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource ArtGlyphBrush}"/>
        </Border>
        <TextBlock x:Name="CompactTitle" Margin="34,0,42,0" VerticalAlignment="Center" FontSize="13"
                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <StackPanel x:Name="EqBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,13,0" Height="14">
          <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
          </Rectangle>
          <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform><ScaleTransform ScaleY="0.35"/></Rectangle.RenderTransform>
          </Rectangle>
        </StackPanel>
      </Grid>

      <Grid x:Name="ExpandedMediaPanel" Style="{StaticResource Panel}" Width="398" Height="184">
        <Grid Margin="18,14,18,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ExpandedArt" CornerRadius="14" Background="{DynamicResource ArtPlaceholder}">
              <TextBlock x:Name="ExpandedArtGlyph" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource ArtGlyphBrush}"/>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ArtistText" FontSize="13.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource SubtleText}"/>
              <TextBlock x:Name="SourceText" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource FaintText}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="ProgressRow" Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/>
              <ColumnDefinition Width="282"/>
              <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Style="{StaticResource Caption}" FontSize="11.5" Text="0:00"/>
            <Grid Grid.Column="1" Width="282" Height="4" VerticalAlignment="Center">
              <Border Background="{DynamicResource TrackBrush}" CornerRadius="2"/>
              <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2"/>
            </Grid>
            <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource Caption}" FontSize="11.5"
                       HorizontalAlignment="Right" Text="-0:00"/>
          </Grid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Background="{DynamicResource ControlBg}"
                    BorderBrush="{DynamicResource ControlRim}" BorderThickness="{DynamicResource ControlRimWidth}" Click="Previous_Click"/>
            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Background="{DynamicResource PrimaryBg}"
                    Foreground="{DynamicResource PrimaryFg}" FontSize="20" Width="44" Height="44"
                    Margin="16,0" Click="PlayPause_Click"/>
            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Background="{DynamicResource ControlBg}"
                    BorderBrush="{DynamicResource ControlRim}" BorderThickness="{DynamicResource ControlRimWidth}" Click="Next_Click"/>
          </StackPanel>

          <Grid Grid.Row="4">
          <StackPanel x:Name="FooterLevel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
            <TextBlock x:Name="FooterLevelGlyph" Style="{StaticResource Icon}" FontSize="12"/>
            <Grid Width="150" Height="4" Margin="8,0" VerticalAlignment="Center">
              <Border Background="{DynamicResource TrackBrush}" CornerRadius="2"/>
              <Border x:Name="FooterLevelFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="White"/>
            </Grid>
            <TextBlock x:Name="FooterLevelValue" Style="{StaticResource Value}" Width="36"/>
          </StackPanel>
          <StackPanel x:Name="FooterStats" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="FooterCpu" Style="{StaticResource Value}" Margin="5,0,16,0" Text="0%"/>
            <TextBlock Text="RAM" Style="{StaticResource Caption}"/>
            <TextBlock x:Name="FooterRam" Style="{StaticResource Value}" Margin="5,0,16,0" Text="0%"/>
            <StackPanel x:Name="FooterBattery" Orientation="Horizontal">
              <Grid Width="21" Height="10" VerticalAlignment="Center">
                <Border Width="19" HorizontalAlignment="Left" BorderBrush="{DynamicResource SubtleText}" BorderThickness="1" CornerRadius="3"/>
                <Border x:Name="FooterBatteryFill" HorizontalAlignment="Left" Margin="2,2,0,2" Width="10" CornerRadius="1"
                        Background="White"/>
                <Border Width="1.5" Height="4" HorizontalAlignment="Right" CornerRadius="0.75" Background="{DynamicResource SubtleText}"/>
              </Grid>
              <TextBlock x:Name="FooterBolt" Style="{StaticResource Icon}" FontSize="10" Margin="3,0,0,0"
                         />
              <TextBlock x:Name="FooterBat" Style="{StaticResource Value}" Margin="4,0,0,0" Text="0%"/>
            </StackPanel>
          </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="ExpandedStatsPanel" Style="{StaticResource Panel}" Width="358" Height="122">
        <StackPanel Margin="20,14,20,0">
          <Grid Margin="0,0,0,10">
            <TextBlock Text="Nothing playing" FontSize="14" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="StatsHintGlyph" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0"
                         Foreground="{DynamicResource SubtleText}"/>
              <TextBlock x:Name="StatsHint" Style="{StaticResource Caption}" Text="Scroll to switch view"/>
            </StackPanel>
          </Grid>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/><ColumnDefinition Width="232"/><ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CPU" Style="{StaticResource Caption}"/>
            <Grid Grid.Column="1" Width="232" Height="5" VerticalAlignment="Center">
              <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5"/>
              <Border x:Name="CpuFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="#64D2FF"/>
            </Grid>
            <TextBlock x:Name="CpuValue" Grid.Column="2" Style="{StaticResource Value}" HorizontalAlignment="Right" Text="0%"/>
          </Grid>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/><ColumnDefinition Width="232"/><ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="RAM" Style="{StaticResource Caption}"/>
            <Grid Grid.Column="1" Width="232" Height="5" VerticalAlignment="Center">
              <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5"/>
              <Border x:Name="RamFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="#BF5AF2"/>
            </Grid>
            <TextBlock x:Name="RamValue" Grid.Column="2" Style="{StaticResource Value}" HorizontalAlignment="Right" Text="0%"/>
          </Grid>

          <Grid x:Name="BatteryRow">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="40"/><ColumnDefinition Width="232"/><ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BatteryCaption" Text="Battery" Style="{StaticResource Caption}"/>
            <Grid Grid.Column="1" Width="232" Height="5" VerticalAlignment="Center">
              <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5"/>
              <Border x:Name="BatFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="#30D158"/>
            </Grid>
            <TextBlock x:Name="BatValue" Grid.Column="2" Style="{StaticResource Value}" HorizontalAlignment="Right" Text="0%"/>
          </Grid>
        </StackPanel>
      </Grid>

      <Grid x:Name="LevelPopupPanel" Style="{StaticResource Panel}" Width="298" Height="38">
        <Grid Margin="16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="LevelGlyph" Style="{StaticResource Icon}" FontSize="15"/>
          <Grid Grid.Column="1" Width="194" Height="5" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Border Background="{DynamicResource TrackBrush}" CornerRadius="2.5"/>
            <Border x:Name="LevelFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="White"/>
          </Grid>
          <TextBlock x:Name="LevelValue" Grid.Column="2" Style="{StaticResource Value}" FontSize="13.5"
                     HorizontalAlignment="Right"/>
        </Grid>
      </Grid>

      <Grid x:Name="InfoPopupPanel" Style="{StaticResource Panel}" Width="338" Height="50">
        <Grid Margin="8,0,16,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/><ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Grid Width="34" Height="34" VerticalAlignment="Center">
            <Border x:Name="InfoArt" CornerRadius="10" Background="{DynamicResource ArtPlaceholder}">
              <TextBlock x:Name="InfoArtGlyph" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource ArtGlyphBrush}"/>
            </Border>
            <Grid x:Name="InfoBattery" Width="28" Height="14" Visibility="Collapsed">
              <Border Width="25" HorizontalAlignment="Left" BorderBrush="{DynamicResource SubtleText}" BorderThickness="1.5" CornerRadius="4"/>
              <Border x:Name="InfoBatteryFill" HorizontalAlignment="Left" Margin="3,3,0,3" Width="10" CornerRadius="1.5"/>
              <Border Width="2" Height="5" HorizontalAlignment="Right" CornerRadius="1" Background="{DynamicResource SubtleText}"/>
            </Grid>
          </Grid>

          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock x:Name="InfoTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="InfoSubtitle" FontSize="13" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource SubtleText}"/>
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
            <TextBlock x:Name="InfoBolt" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,3,0"/>
            <TextBlock x:Name="InfoTrailing" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="ClipboardPanel" Style="{StaticResource Panel}" Width="398" Height="114">
        <StackPanel Margin="18,12,18,0">
          <Grid Margin="0,0,0,9">
            <TextBlock Text="Clipboard" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="ClipHint" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                       Text="Click a picture to copy it"/>
          </Grid>
          <Grid Height="64">
            <StackPanel x:Name="ClipStrip" Orientation="Horizontal"/>
            <TextBlock x:Name="ClipEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center"
                       Text="Screenshots and photos will show up here"/>
          </Grid>
        </StackPanel>
      </Grid>

      <Grid x:Name="CpPanel" Style="{StaticResource Panel}" Width="804" Height="128">
        <Grid Margin="0,13,162,0" HorizontalAlignment="Right" Width="364" VerticalAlignment="Top" Height="46">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Button x:Name="CpWifiTile" Style="{StaticResource CpTile}" Click="CpWifi_Click">
              <DockPanel Margin="12,0,40,0">
                <TextBlock DockPanel.Dock="Left" Text="&#xE701;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Wi-Fi" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CpWifiStatus" FontSize="11.5" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Button>

            <Border HorizontalAlignment="Right" Width="1" Margin="0,11,36,11" IsHitTestVisible="False"
                    Background="{Binding Foreground, ElementName=CpWifiTile}" Opacity="0.25"/>
            <Button x:Name="CpWifiMore" Style="{StaticResource CpTile}" Background="Transparent" HorizontalAlignment="Right"
                    Width="30" Margin="0,4,4,4" Click="CpWifiMore_Click" ToolTip="Choose a network"
                    Foreground="{Binding Foreground, ElementName=CpWifiTile}">
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </Grid>
          <Grid Grid.Column="2">
            <Button x:Name="CpBtTile" Style="{StaticResource CpTile}" Click="CpBt_Click">
              <DockPanel Margin="12,0,40,0">
                <TextBlock DockPanel.Dock="Left" Text="&#xE702;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Bluetooth" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CpBtStatus" FontSize="11.5" Opacity="0.75" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DockPanel>
            </Button>

            <Border HorizontalAlignment="Right" Width="1" Margin="0,11,36,11" IsHitTestVisible="False"
                    Background="{Binding Foreground, ElementName=CpBtTile}" Opacity="0.25"/>
            <Button x:Name="CpBtMore" Style="{StaticResource CpTile}" Background="Transparent" HorizontalAlignment="Right"
                    Width="30" Margin="0,4,4,4" Click="CpBtMore_Click" ToolTip="Bluetooth devices"
                    Foreground="{Binding Foreground, ElementName=CpBtTile}">
              <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </Grid>
        </Grid>
        <Grid Margin="0,67,162,0" HorizontalAlignment="Right" Width="364" VerticalAlignment="Top" Height="46">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="CpEnergyTile" Grid.Column="0" Style="{StaticResource CpTile}" Click="CpEnergy_Click">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE868;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center"/>
              <TextBlock Text="Energy saver" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="CpPhoneTile" Grid.Column="2" Style="{StaticResource CpTile}" Click="CpPhone_Click">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center"/>
              <TextBlock Text="Phone Link" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="CpAirplaneTile" Grid.Column="4" Style="{StaticResource CpTile}" Click="CpAirplane_Click">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE709;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center"/>
              <TextBlock Text="Airplane" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="CpNearbyTile" Grid.Column="6" Style="{StaticResource CpTile}" Click="CpNearby_Click">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="&#xE72D;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center"/>
              <TextBlock Text="Nearby share" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Button>
        </Grid>

        <Grid Margin="0,0,16,0" HorizontalAlignment="Right" Width="130" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/><ColumnDefinition Width="10"/><ColumnDefinition Width="60"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <Grid Width="60" Height="60">
              <ui:RingMeter x:Name="BenchTempRing" Track="{DynamicResource TrackBrush}"/>
              <TextBlock x:Name="BenchTempValue" Style="{StaticResource Value}" FontSize="18" HorizontalAlignment="Center" Text="…"/>
            </Grid>
            <TextBlock Text="TEMP" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Grid Width="60" Height="60">
              <ui:RingMeter x:Name="BenchFreqRing" Track="{DynamicResource TrackBrush}"/>
              <TextBlock x:Name="BenchFreqValue" Style="{StaticResource Value}" FontSize="18" HorizontalAlignment="Center" Text="…"/>
            </Grid>
            <TextBlock Text="GHz" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
        </Grid>

        <Grid Margin="18,0,0,0" HorizontalAlignment="Left" Width="250" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/><ColumnDefinition Width="10"/><ColumnDefinition Width="60"/>
            <ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <Grid Width="60" Height="60">
              <ui:RingMeter x:Name="BenchCpuRing" Track="{DynamicResource TrackBrush}"/>
              <TextBlock x:Name="BenchCpuValue" Style="{StaticResource Value}" FontSize="18" HorizontalAlignment="Center" Text="0"/>
            </Grid>
            <TextBlock Text="CPU" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Grid Width="60" Height="60">
              <ui:RingMeter x:Name="BenchRamRing" Track="{DynamicResource TrackBrush}"/>
              <TextBlock x:Name="BenchRamValue" Style="{StaticResource Value}" FontSize="18" HorizontalAlignment="Center" Text="0"/>
            </Grid>
            <TextBlock Text="RAM" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="4" VerticalAlignment="Center">
            <Grid>
              <TextBlock Text="DISK" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="BenchDiskValue" Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Right" Text="…"/>
            </Grid>
            <ui:Sparkline x:Name="BenchDiskLine" Floor="5" Height="14" Margin="0,1,0,3"/>
            <Grid>
              <TextBlock x:Name="BenchGpuLabel" Text="GPU" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="BenchGpuValue" Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Right" Text="…"/>
            </Grid>
            <ui:Sparkline x:Name="BenchGpuLine" Max="100" Height="14" Margin="0,1,0,3"/>
            <Grid>
              <TextBlock Text="NVIDIA" Style="{StaticResource Caption}"/>
              <TextBlock x:Name="BenchNvidiaValue" Style="{StaticResource Value}" FontSize="12" HorizontalAlignment="Right" Text="…"/>
            </Grid>
            <ui:Sparkline x:Name="BenchNvidiaLine" Max="100" Height="14" Margin="0,1,0,0"/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="CpMenuPanel" Style="{StaticResource Panel}" Width="398" Height="184">
        <DockPanel Margin="14,12,14,8">
          <Grid DockPanel.Dock="Top" Height="28" Margin="0,0,0,6">
            <Button x:Name="CpMenuBack" Style="{StaticResource CpTile}" Width="28" HorizontalAlignment="Left"
                    Click="CpMenuBack_Click" ToolTip="Back">
              <TextBlock Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <TextBlock x:Name="CpMenuTitle" Margin="38,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="CpMenuNote" Style="{StaticResource Caption}" Margin="110,0,0,0" HorizontalAlignment="Right"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>
          <ScrollViewer x:Name="CpMenuScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel x:Name="CpMenuList"/>
          </ScrollViewer>
        </DockPanel>
      </Grid>

      <Grid x:Name="NotificationsPanel" Style="{StaticResource Panel}" Width="398" Height="184">
        <DockPanel Margin="18,12,14,8">
          <Grid DockPanel.Dock="Top" Height="26" Margin="0,0,0,8">
            <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="NotesCount" Style="{StaticResource Caption}" Margin="104,0,0,0"/>
            <Button x:Name="NotesClear" Style="{StaticResource CpTile}" HorizontalAlignment="Right" Width="76"
                    Click="NotesClear_Click" ToolTip="Clear every notification" Visibility="Collapsed">
              <TextBlock Text="Clear all" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </Button>
          </Grid>
          <Grid>
            <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel x:Name="NotesList"/>
            </ScrollViewer>
            <TextBlock x:Name="NotesEmpty" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,24"
                       TextWrapping="Wrap" TextAlignment="Center" Text="No notifications"/>
          </Grid>
        </DockPanel>
      </Grid>

    </Grid>
  </Border>
</Window>
