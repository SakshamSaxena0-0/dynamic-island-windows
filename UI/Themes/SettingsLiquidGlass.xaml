<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="LgBone" Color="#ECECE8"/>
  <SolidColorBrush x:Key="LgInk" Color="#000000"/>
  <SolidColorBrush x:Key="LgDim" Color="#99ECECE8"/>
  <SolidColorBrush x:Key="LgDimmer" Color="#66ECECE8"/>
  <SolidColorBrush x:Key="LgRule" Color="#21FFFFFF"/>
  <SolidColorBrush x:Key="LgRuleHi" Color="#4DFFFFFF"/>
  <SolidColorBrush x:Key="LgActive" Color="#F4F4F1"/>
  <LinearGradientBrush x:Key="LgSolid" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/>
    <GradientStop Color="#ECECE8" Offset="0.48"/>
    <GradientStop Color="#BDBDB8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LgGlass" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#21FFFFFF" Offset="0"/>
    <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
    <GradientStop Color="#12FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LgGlassHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3DFFFFFF" Offset="0"/>
    <GradientStop Color="#17FFFFFF" Offset="0.5"/>
    <GradientStop Color="#24FFFFFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LgCard" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1AFFFFFF" Offset="0"/>
    <GradientStop Color="#08FFFFFF" Offset="0.5"/>
    <GradientStop Color="#0DFFFFFF" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="LgRim" Color="#21FFFFFF"/>

  <SolidColorBrush x:Key="LgPopRim" Color="#21FFFFFF"/>
  <LinearGradientBrush x:Key="LgStrong" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F5141414" Offset="0"/>
    <GradientStop Color="#F7060606" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="LgSteel" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#CACAC6" Offset="0"/>
    <GradientStop Color="#8E8E8A" Offset="0.06"/>
    <GradientStop Color="#F2F2EE" Offset="0.125"/>
    <GradientStop Color="#7E7E7A" Offset="0.19"/>
    <GradientStop Color="#A2A29E" Offset="0.25"/>
    <GradientStop Color="#DCDCD8" Offset="0.32"/>
    <GradientStop Color="#FFFFFF" Offset="0.375"/>
    <GradientStop Color="#D0D0CC" Offset="0.43"/>
    <GradientStop Color="#82827E" Offset="0.5"/>
    <GradientStop Color="#72726E" Offset="0.57"/>
    <GradientStop Color="#E6E6E2" Offset="0.625"/>
    <GradientStop Color="#7A7A76" Offset="0.69"/>
    <GradientStop Color="#AAAAA6" Offset="0.75"/>
    <GradientStop Color="#E0E0DC" Offset="0.82"/>
    <GradientStop Color="#FFFFFF" Offset="0.875"/>
    <GradientStop Color="#E6E6E2" Offset="0.94"/>
    <GradientStop Color="#CACAC6" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#ECECE8"/>
  <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#99ECECE8"/>
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#000000"/>
  <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#21FFFFFF"/>
  <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#21FFFFFF"/>
  <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#4DFFFFFF"/>
  <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0AFFFFFF"/>
  <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#0E0E0E"/>
  <SolidColorBrush x:Key="HeaderRule" Color="#21FFFFFF"/>
  <LinearGradientBrush x:Key="AccentFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0"/>
    <GradientStop Color="#ECECE8" Offset="0.48"/>
    <GradientStop Color="#BDBDB8" Offset="1"/>
  </LinearGradientBrush>

  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
  </Style>
  <Style x:Key="Section" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="FontWeight" Value="ExtraBold"/>
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="Margin" Value="10,28,0,8"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Foreground" Value="{StaticResource LgDim}"/>
  </Style>
  <Style x:Key="ValueText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Width" Value="62"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource LgDim}"/>
  </Style>
  <Style x:Key="PresetName" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="8,8,0,5"/>
  </Style>

  <Style x:Key="Row" TargetType="Border">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="10,11"/>
    <Setter Property="MinHeight" Value="58"/>
    <Setter Property="TextElement.FontWeight" Value="Bold"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#0AFFFFFF"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="RowText" TargetType="StackPanel">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,20,0"/>
  </Style>

  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#73000000"
                  BorderThickness="1" BorderBrush="#12FFFFFF">
            <Ellipse x:Name="Knob" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFFFFF" Offset="0"/>
                  <GradientStop Color="#C6C7CE" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource LgSolid}"/>
              <Setter TargetName="Track" Property="BorderBrush" Value="#59000000"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource LgInk}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource LgBone}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SegmentBar" TargetType="Border">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource LgGlass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LgRim}"/>
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" CornerRadius="7" Padding="12,7" Background="Transparent">
            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{StaticResource LgDim}"
                              TextElement.FontFamily="{DynamicResource MonoFont}"
                              TextElement.FontSize="11.5" TextElement.FontWeight="Bold"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource LgBone}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource LgSolid}"/>
              <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource LgInk}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PresetButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Margin" Value="0,0,12,12"/>
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="10" BorderThickness="1" Padding="4" Background="{StaticResource LgCard}"
                  BorderBrush="{StaticResource LgRim}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource LgGlass}"/>
              <Setter TargetName="Bd" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="-3"/></Setter.Value>
              </Setter>
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LgSolid}"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Bd" Property="Padding" Value="3"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="Background" Value="{StaticResource LgGlass}"/>
    <Setter Property="BorderBrush" Value="{StaticResource LgSteel}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,7"/>
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource LgGlassHover}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Primary">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource LgSolid}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="#66000000"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{StaticResource LgInk}"/>
              <Setter Property="FontWeight" Value="ExtraBold"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LgBone}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="CaretBrush" Value="{StaticResource LgBone}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource LgBone}"/>
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="7" BorderThickness="1" Padding="8,6" Background="{StaticResource LgGlass}"
                  BorderBrush="{StaticResource LgRim}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LgBone}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LgSliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="6" CornerRadius="3,0,0,3" VerticalAlignment="Center" Margin="0,0,-12,0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#A5A5A2" Offset="0"/>
                  <GradientStop Color="#ECECE8" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LgSliderRest" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LgSliderThumb" TargetType="Thumb">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid Width="26" Height="26" Background="Transparent">
            <Ellipse Fill="#26ECECE8"/>
            <Ellipse x:Name="Dot" Width="18" Height="18" RenderTransformOrigin="0.5,0.5">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#FFFFFF" Offset="0"/>
                  <GradientStop Color="#C9CAD1" Offset="1"/>
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Dot" Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="1.18" ScaleY="1.18"/></Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Height="26" Background="Transparent">
            <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="#73000000"
                    BorderThickness="0,0,0,1" BorderBrush="#0FFFFFFF"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource LgSliderFill}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource LgSliderRest}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource LgSliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9"/>
    <Setter Property="MinWidth" Value="9"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource LgSliderRest}"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource LgSliderRest}"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Border x:Name="Bar" Margin="3,0" CornerRadius="1.5" Background="#1AFFFFFF"/>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="#33FFFFFF"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Height="38" CornerRadius="11" Padding="12,0" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2EECECE8" Offset="0"/>
                    <GradientStop Color="#08FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource LgActive}"/>
              <Setter Property="FontWeight" Value="ExtraBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="36"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" CornerRadius="9" BorderThickness="2" Background="{StaticResource LgGlass}"
                          BorderBrush="{StaticResource LgSteel}">
                    <Path Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource LgBone}" StrokeThickness="1.6"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{StaticResource LgGlassHover}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="14,8,34,8" VerticalAlignment="Center"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      CornerRadius="18" Padding="7" BorderThickness="1.5" Background="{StaticResource LgStrong}"
                      BorderBrush="{StaticResource LgPopRim}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource LgBone}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border CornerRadius="9" Padding="10,6" BorderThickness="1" Background="{StaticResource LgStrong}"
                  BorderBrush="{StaticResource LgPopRim}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
